#include <reg51.h>

// Warning Indicators
sbit LOW_FUEL   = P1^0;
sbit ENGINE_HOT = P1^1;
sbit OVER_SPEED = P1^2;

void main()
{
    // Simulated Sensor Values
    unsigned char speed = 120;   // km/h
    unsigned char fuel  = 15;    // %
    unsigned char temp  = 95;    // °C

    while(1)
    {
        // Low Fuel Check
        if(fuel < 20)
            LOW_FUEL = 1;
        else
            LOW_FUEL = 0;

        // Engine Temperature Check
        if(temp > 90)
            ENGINE_HOT = 1;
        else
            ENGINE_HOT = 0;

        // Over Speed Check
        if(speed > 100)
            OVER_SPEED = 1;
        else
            OVER_SPEED = 0;
    }
}
